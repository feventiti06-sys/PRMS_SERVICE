# PRMS Frontend Environment Configuration — Example
# Copy this file to .env and fill in the correct values.
# Never commit .env to version control.

# Backend API base URL
# Must point to the Spring Boot PRMS service with /api/v1 base path.
# Default: http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
