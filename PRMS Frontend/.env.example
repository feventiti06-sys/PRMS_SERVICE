# PRMS Frontend Environment Configuration
# Copy to .env.local and fill in values. Never commit .env.local.

# Backend API base URL (Spring Boot)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Keycloak
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=prms
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=prms-frontend
